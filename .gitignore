# Keep source/runtime resources, Gradle Wrapper and required build inputs versioned.
# Only the local Gradle launcher and required test fixture are build inputs.
/scripts/*
!/scripts/gradle-local.ps1
!/scripts/tests/
/scripts/tests/*
!/scripts/tests/spell_arena.snbt

# Local collaboration preferences; do not distribute with source.
/DEVELOPMENT_PREFERENCES.local.md

# Local runtime configuration and asset-script caches.
/config/*
!/config/development-mods.json
__pycache__/
*.pyc
*.pyo
